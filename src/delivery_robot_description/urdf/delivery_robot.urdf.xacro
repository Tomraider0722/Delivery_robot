<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="delivery_robot">

    <!-- Base Link -->
    <link name="base_link">

        <visual>
            <origin xyz="0 0 0.20"/>
            <geometry>
                <box size="0.60 0.45 0.20"/>
            </geometry>

            <material name="blue">
                <color rgba="0.2 0.4 0.8 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.20"/>
            <geometry>
                <box size="0.60 0.45 0.20"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.20"/>
            <mass value="20.0"/>

            <inertia
                ixx="0.50"
                ixy="0.0"
                ixz="0.0"
                iyy="0.80"
                iyz="0.0"
                izz="1.00"/>

        </inertial>

    </link>
    
<!-- ================= Wheel Macro ================= -->
<xacro:macro name="wheel" params="wheel_name joint_name x y z">

    <link name="${wheel_name}">

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.05"/>
            </geometry>

            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="2.0"/>

            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>

    <joint name="${joint_name}" type="continuous">

        <parent link="base_link"/>
        <child link="${wheel_name}"/>

        <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>

</xacro:macro>

<!-- ================= Instantiate Wheels ================= -->

<xacro:wheel
    wheel_name="front_left_wheel"
    joint_name="front_left_wheel_joint"
    x="0.175"
    y="0.251"
    z="0.125"/>

<xacro:wheel
    wheel_name="front_right_wheel"
    joint_name="front_right_wheel_joint"
    x="0.175"
    y="-0.251"
    z="0.125"/>

<xacro:wheel
    wheel_name="rear_left_wheel"
    joint_name="rear_left_wheel_joint"
    x="-0.175"
    y="0.251"
    z="0.125"/>

<xacro:wheel
    wheel_name="rear_right_wheel"
    joint_name="rear_right_wheel_joint"
    x="-0.175"
    y="-0.251"
    z="0.125"/>
    
<!-- ================= LiDAR ================= -->

<link name="lidar_link">

    <visual>
        <geometry>
            <cylinder radius="0.04" length="0.07"/>
        </geometry>

        <material name="dark_gray">
            <color rgba="0.3 0.3 0.3 1"/>
        </material>
    </visual>

    <collision>
        <geometry>
            <cylinder radius="0.04" length="0.07"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>

        <inertia
            ixx="0.0005"
            ixy="0"
            ixz="0"
            iyy="0.0005"
            iyz="0"
            izz="0.0005"/>
    </inertial>

</link>

<link name="camera_link">

  <visual>
    <geometry>
      <box size="0.05 0.04 0.03"/>
    </geometry>

    <material name="green">
      <color rgba="1 0.65 0 1"/>
    </material>
  </visual>

  <collision>
    <geometry>
      <box size="0.05 0.04 0.03"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.2"/>

    <origin xyz="0 0 0"/>

    <inertia
      ixx="0.0001"
      iyy="0.0001"
      izz="0.0001"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>

</link>

<joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>

    <child link="lidar_link"/>

    <origin xyz="0.15 0 0.335"
            rpy="0 0 0"/>

</joint>

<gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

<joint name="camera_joint" type="fixed">

  <parent link="base_link"/>
  <child link="camera_link"/>

  <origin xyz="0.15 0.0 0.385" rpy="0 0 0"/>

</joint>

<link name="camera_optical_frame"/>

<joint name="camera_optical_joint" type="fixed">
  <parent link="camera_link"/>
  <child link="camera_optical_frame"/>

  <origin xyz="0 0 0"
          rpy="-1.5708 0 -1.5708"/>
</joint>

<ros2_control name="GazeboSystem" type="system">

  <hardware>
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>

  <joint name="front_left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="front_right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="rear_left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="rear_right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

</ros2_control>

<xacro:arg name="controllers_config" default="" />

<gazebo>
  <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(arg controllers_config)</parameters>
  </plugin>
</gazebo>

<!-- ================= LiDAR Sensor ================= -->

<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <topic>/scan</topic>

    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <always_on>true</always_on>
    <visualize>false</visualize>
  </sensor>
</gazebo>

<!-- ================= Camera Sensor ================= -->

<gazebo reference="camera_link">

  <sensor name="camera_sensor" type="camera">

    <topic>/camera/image</topic>

    <update_rate>5</update_rate>

    <camera>

      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>320</width>
        <height>240</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>

    </camera>

    <always_on>true</always_on>
    <visualize>false</visualize>

  </sensor>

</gazebo>

</robot>