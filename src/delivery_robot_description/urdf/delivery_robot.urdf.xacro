<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="delivery_robot">

    <!-- Colours (visual only) -->
    <material name="body_white"><color rgba="0.92 0.93 0.95 1.0"/></material>
    <material name="body_teal"><color rgba="0.05 0.45 0.55 1.0"/></material>
    <material name="chassis_dark"><color rgba="0.15 0.16 0.18 1.0"/></material>
    <material name="lid_gray"><color rgba="0.70 0.72 0.76 1.0"/></material>
    <material name="tire_black"><color rgba="0.06 0.06 0.06 1.0"/></material>
    <material name="rim_silver"><color rgba="0.75 0.77 0.80 1.0"/></material>
    <material name="headlight"><color rgba="1.0 0.82 0.20 1.0"/></material>
    <material name="taillight"><color rgba="0.85 0.05 0.05 1.0"/></material>
    <material name="beacon_amber"><color rgba="1.0 0.60 0.0 1.0"/></material>
    <material name="lens_black"><color rgba="0.02 0.02 0.03 1.0"/></material>

    <!-- Base Link -->
    <link name="base_link">

        <!-- Looks only - the layers below fill the same 0.60 x 0.45 x 0.20 m
             envelope as the collision box. Nothing sits at lidar height
             (z = 0.335 m) because the lidar renders visuals. -->
        <visual name="chassis_skirt">
            <origin xyz="0 0 0.12"/>
            <geometry><box size="0.60 0.45 0.04"/></geometry>
            <material name="chassis_dark"/>
        </visual>
        <visual name="body_shell">
            <origin xyz="0 0 0.22"/>
            <geometry><box size="0.60 0.45 0.16"/></geometry>
            <material name="body_white"/>
        </visual>
        <visual name="side_stripe">
            <origin xyz="0 0 0.20"/>
            <geometry><box size="0.50 0.451 0.03"/></geometry>
            <material name="body_teal"/>
        </visual>
        <visual name="top_lid">
            <origin xyz="-0.06 0 0.31"/>
            <geometry><box size="0.36 0.38 0.02"/></geometry>
            <material name="lid_gray"/>
        </visual>
        <visual name="headlight_left">
            <origin xyz="0.301 0.15 0.24"/>
            <geometry><box size="0.004 0.07 0.03"/></geometry>
            <material name="headlight"/>
        </visual>
        <visual name="headlight_right">
            <origin xyz="0.301 -0.15 0.24"/>
            <geometry><box size="0.004 0.07 0.03"/></geometry>
            <material name="headlight"/>
        </visual>
        <visual name="taillight_left">
            <origin xyz="-0.301 0.15 0.24"/>
            <geometry><box size="0.004 0.07 0.03"/></geometry>
            <material name="taillight"/>
        </visual>
        <visual name="taillight_right">
            <origin xyz="-0.301 -0.15 0.24"/>
            <geometry><box size="0.004 0.07 0.03"/></geometry>
            <material name="taillight"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.20"/>
            <geometry>
                <box size="0.60 0.45 0.20"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.20"/>
            <mass value="20.0"/>

            <inertia
                ixx="0.50"
                ixy="0.0"
                ixz="0.0"
                iyy="0.80"
                iyz="0.0"
                izz="1.00"/>

        </inertial>

    </link>
    
<!-- ================= Wheel Macro ================= -->
<xacro:macro name="wheel" params="wheel_name joint_name x y z">

    <link name="${wheel_name}">

        <!-- Looks only - tyre, rim, hub and spokes (spokes make the
             rotation visible). Collision below is unchanged. -->
        <visual name="tire">
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.05"/>
            </geometry>
            <material name="tire_black"/>
        </visual>
        <visual name="rim">
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.085" length="0.052"/>
            </geometry>
            <material name="rim_silver"/>
        </visual>
        <visual name="hub">
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.056"/>
            </geometry>
            <material name="chassis_dark"/>
        </visual>
        <visual name="spoke_a">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.16 0.054 0.014"/></geometry>
            <material name="chassis_dark"/>
        </visual>
        <visual name="spoke_b">
            <origin xyz="0 0 0" rpy="0 1.0472 0"/>
            <geometry><box size="0.16 0.054 0.014"/></geometry>
            <material name="chassis_dark"/>
        </visual>
        <visual name="spoke_c">
            <origin xyz="0 0 0" rpy="0 2.0944 0"/>
            <geometry><box size="0.16 0.054 0.014"/></geometry>
            <material name="chassis_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="2.0"/>

            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>

    <joint name="${joint_name}" type="continuous">

        <parent link="base_link"/>
        <child link="${wheel_name}"/>

        <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>

</xacro:macro>

<!-- ================= Instantiate Wheels ================= -->

<xacro:wheel
    wheel_name="front_left_wheel"
    joint_name="front_left_wheel_joint"
    x="0.175"
    y="0.251"
    z="0.125"/>

<xacro:wheel
    wheel_name="front_right_wheel"
    joint_name="front_right_wheel_joint"
    x="0.175"
    y="-0.251"
    z="0.125"/>

<xacro:wheel
    wheel_name="rear_left_wheel"
    joint_name="rear_left_wheel_joint"
    x="-0.175"
    y="0.251"
    z="0.125"/>

<xacro:wheel
    wheel_name="rear_right_wheel"
    joint_name="rear_right_wheel_joint"
    x="-0.175"
    y="-0.251"
    z="0.125"/>
    
<!-- ================= LiDAR ================= -->

<link name="lidar_link">

    <visual name="lidar_housing">
        <geometry>
            <cylinder radius="0.04" length="0.07"/>
        </geometry>
        <material name="chassis_dark"/>
    </visual>
    <visual name="lidar_cap">
        <origin xyz="0 0 0.038"/>
        <geometry>
            <cylinder radius="0.045" length="0.008"/>
        </geometry>
        <material name="rim_silver"/>
    </visual>

    <collision>
        <geometry>
            <cylinder radius="0.04" length="0.07"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>

        <inertia
            ixx="0.0005"
            ixy="0"
            ixz="0"
            iyy="0.0005"
            iyz="0"
            izz="0.0005"/>
    </inertial>

</link>

<link name="camera_link">

  <visual name="camera_body">
    <geometry>
      <box size="0.05 0.04 0.03"/>
    </geometry>
    <material name="chassis_dark"/>
  </visual>
  <!-- Mast from the lidar cap up to the camera. It is above the lidar plane, so the scan is unaffected. -->
  <visual name="camera_mast">
    <origin xyz="0 0 -0.065"/>
    <geometry>
      <cylinder radius="0.01" length="0.10"/>
    </geometry>
    <material name="chassis_dark"/>
  </visual>
  <!-- Status beacon above the camera (above lidar plane, outside camera view). -->
  <visual name="beacon">
    <origin xyz="0 0 0.03"/>
    <geometry>
      <cylinder radius="0.02" length="0.03"/>
    </geometry>
    <material name="beacon_amber"/>
  </visual>

  <collision>
    <geometry>
      <box size="0.05 0.04 0.03"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.2"/>

    <origin xyz="0 0 0"/>

    <inertia
      ixx="0.0001"
      iyy="0.0001"
      izz="0.0001"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>

</link>

<joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>

    <child link="lidar_link"/>

    <origin xyz="0.15 0 0.335"
            rpy="0 0 0"/>

</joint>

<gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

<joint name="camera_joint" type="fixed">

  <parent link="base_link"/>
  <child link="camera_link"/>

  <origin xyz="0.15 0.0 0.485" rpy="0 0 0"/>

</joint>

<!-- IMU (gyroscope and accelerometer) inside the body, at the centre -->
<link name="imu_link">
  <inertial>
    <mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
  </inertial>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0 0 0.15" rpy="0 0 0"/>
</joint>

<gazebo reference="imu_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

<link name="camera_optical_frame"/>

<joint name="camera_optical_joint" type="fixed">
  <parent link="camera_link"/>
  <child link="camera_optical_frame"/>

  <origin xyz="0 0 0"
          rpy="-1.5708 0 -1.5708"/>
</joint>

<ros2_control name="GazeboSystem" type="system">

  <hardware>
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>

  <joint name="front_left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="front_right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="rear_left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="rear_right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

</ros2_control>

<xacro:arg name="controllers_config" default="" />

<gazebo>
  <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(arg controllers_config)</parameters>
  </plugin>
</gazebo>

<!-- ================= LiDAR Sensor ================= -->

<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <topic>/scan</topic>

    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <always_on>true</always_on>
    <visualize>false</visualize>
  </sensor>
</gazebo>

<!-- ================= IMU Sensor ================= -->

<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <topic>/imu</topic>
    <update_rate>100</update_rate>
    <always_on>true</always_on>
    <visualize>false</visualize>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0005</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0005</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0005</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<!-- ================= Camera Sensor ================= -->

<gazebo reference="camera_link">

  <!-- RGB-D camera - colour image plus a depth image (used for visual SLAM
       and, later, perception). Topics /camera/image, /camera/depth_image,
       /camera/camera_info. -->
  <sensor name="camera_sensor" type="rgbd_camera">

    <topic>/camera</topic>

    <update_rate>15</update_rate>

    <camera>

      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.05</near>
        <far>10.0</far>
      </clip>

      <depth_camera>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
      </depth_camera>

    </camera>

    <always_on>true</always_on>
    <visualize>false</visualize>

  </sensor>

</gazebo>

</robot>