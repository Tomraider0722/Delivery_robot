<?xml version="1.0"?>
<sdf version="1.9">
  <world name="delivery_warehouse">

    <!-- ========================================================= -->
    <!-- PHYSICS                                                    -->
    <!-- ========================================================= -->
    <physics name="warehouse_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ========================================================= -->
    <!-- GAZEBO SYSTEMS                                             -->
    <!-- ========================================================= -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ========================================================= -->
    <!-- SCENE                                                      -->
    <!-- ========================================================= -->
    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.08 0.08 0.08 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- ========================================================= -->
    <!-- DIRECTIONAL LIGHT                                          -->
    <!-- ========================================================= -->
    <light name="warehouse_sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.75 0.75 0.75 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.25 0.20 -1.0</direction>
    </light>

    <!-- ========================================================= -->
    <!-- FLOOR                                                      -->
    <!-- 12 m x 10 m                                                -->
    <!-- ========================================================= -->
    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry>
            <box>
              <size>12.0 10.0 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>12.0 10.0 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.48 0.48 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- OUTER WALL - LEFT                                          -->
    <!-- ========================================================= -->
    <model name="outer_wall_left">
      <static>true</static>
      <pose>-5.9 0 1.25 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 10.0 2.50</size>
            </box>
          </geometry>
        </collision>
